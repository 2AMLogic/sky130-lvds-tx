{
 "netlist": "../diag-deck-negctl.spice",
 "models": {
  "pdk": "sky130A",
  "lib": "libs.tech/ngspice/sky130.lib.spice"
 },
 "corners": {
  "process": [
   "tt"
  ],
  "temperature_c": [
   27
  ],
  "supply_v": {
   "VVCCD": [
    1.8
   ],
   "VVDDIO": [
    3.3
   ]
  }
 },
 "analysis": {
  "kind": "op",
  "args": ""
 },
 "measurements": [
  {
   "name": "v_od_1",
   "expr": "v(outp1)-v(outn1)",
   "unit": "V"
  },
  {
   "name": "v_os_1",
   "expr": "(v(outp1)+v(outn1))/2",
   "unit": "V",
   "limits": {
    "min": 1.175,
    "max": 1.325
   },
   "spec_row": "E2",
   "comment": "negative control: VCMREF is moved to 1.35 V, so this regulation-band check (same limits as v_os_reg_1 in ../request.json) MUST fail"
  }
 ],
 "options": {
  "stage_model_inputs": true,
  "ngspice_init": [
   "set wnflag=1",
   "set num_threads=1"
  ],
  "node_voltage_bounds": {
   "min": -0.5,
   "max": 4.0
  }
 }
}