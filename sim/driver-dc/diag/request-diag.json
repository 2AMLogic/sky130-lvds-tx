{
  "netlist": "../driver_dc.spice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": ["tt"],
    "temperature_c": [27],
    "supply_v": {
      "VVCCD": [1.8],
      "VVDDIO": [3.3]
    }
  },
  "analysis": {
    "kind": "op",
    "args": ""
  },
  "measurements": [
    {"name": "v_od_1",  "expr": "v(outp1)-v(outn1)", "unit": "V"},
    {"name": "v_os_1",  "expr": "(v(outp1)+v(outn1))/2", "unit": "V"},
    {"name": "iref_v",  "expr": "v(iref1)", "unit": "V"},
    {"name": "biasp",   "expr": "v(xdrv1.biasp)", "unit": "V"},
    {"name": "vcmfb",   "expr": "v(xdrv1.vcmfb)", "unit": "V"},
    {"name": "n1",      "expr": "v(xdrv1.n1)", "unit": "V"},
    {"name": "tail",    "expr": "v(xdrv1.tail)", "unit": "V"},
    {"name": "vcms",    "expr": "v(xdrv1.vcms)", "unit": "V"},
    {"name": "pgm",     "expr": "v(xdrv1.pgm)", "unit": "V"},
    {"name": "ngm",     "expr": "v(xdrv1.ngm)", "unit": "V"},
    {"name": "top",     "expr": "v(xdrv1.xsl_main.top)", "unit": "V"},
    {"name": "bot",     "expr": "v(xdrv1.xsl_main.bot)", "unit": "V"},
    {"name": "well",    "expr": "v(xdrv1.xsl_main.well)", "unit": "V"},
    {"name": "enh",     "expr": "v(xdrv1.xsel_en.enh)", "unit": "V"},
    {"name": "outp",    "expr": "v(outp1)", "unit": "V"},
    {"name": "outn",    "expr": "v(outn1)", "unit": "V"}
  ],
  "options": {
    "stage_model_inputs": true,
    "ngspice_init": ["set wnflag=1", "set num_threads=1"],
    "node_voltage_bounds": {"min": -0.5, "max": 4.0}
  }
}
