{
  "netlist": "pad_shunt.spice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "process": [
      "tt",
      "ff",
      "ss",
      "sf",
      "fs"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ],
    "options": {
      "gmin": [
        1e-15
      ]
    }
  },
  "analysis_steps": [
    {
      "name": "op_1v25",
      "analysis": {
        "kind": "op",
        "args": ""
      },
      "alter": {
        "VPAD": 1.25
      },
      "measurements": [
        {
          "name": "ishunt",
          "expr": "abs(i(vpad))",
          "unit": "A"
        }
      ]
    },
    {
      "name": "ac_1v25",
      "analysis": {
        "kind": "ac",
        "args": "lin 1 1meg 1meg"
      },
      "measurements": [
        {
          "name": "cpad",
          "expr": "abs(imag(i(vpad)))/6.283185307179586e6",
          "unit": "F"
        }
      ]
    },
    {
