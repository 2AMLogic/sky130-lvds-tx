{
 "netlist_source": "schematic",
 "models": {
  "pdk": "sky130A",
  "lib": "libs.tech/ngspice/sky130.lib.spice"
 },
 "corners": {
  "process": [
   "tt",
   "sf",
   "ff",
   "ss",
   "fs"
  ],
  "temperature_c": [
   -40,
   125
  ]
 },
 "options": {
  "timeout_s": 360,
  "stage_model_inputs": true,
  "ngspice_init": [
   "set wnflag=1"
  ],
  "fail_on_diagnostic": [
   "nonconvergence"
  ],
  "node_voltage_bounds": {
   "min": -3.63,
   "max": 3.63
  }
 },
