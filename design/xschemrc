#### sky130-lvds-tx :: project-local xschem configuration for design/.
####
#### Passed to `klt netlist --rcfile design/xschemrc` (see design/README.md).
#### It only sets the symbol search path:
####   - the sky130A PDK's `sky130_fd_pr/` symbols (nfet_01v8, pfet_g5v0d10v5, diode, ...),
####     first, because xschem's own `devices/diode.sym` has the same name;
####   - xschem's own `devices/` (ipin, opin, iopin, lab_pin);
####   - this block's cell directories, so a cell instantiates its sub-cells by
####     bare symbol name (`ddr_mux.sym`).
#### A path that fails to resolve makes xschem instantiate a pin-less
#### placeholder and emit auto-named nets without reporting an error, so
#### design/README.md says how to check the netlist for that.
####
#### PDK_ROOT / PDK follow the environment (docs/environment.md), defaulting
#### to the pinned install under ~/.ciel.

if { [info exists env(PDK_ROOT)] && $env(PDK_ROOT) ne {} } {
  set PDK_ROOT $env(PDK_ROOT)
} else {
  set PDK_ROOT $env(HOME)/.ciel
}
if { [info exists env(PDK)] && $env(PDK) ne {} } {
  set PDK $env(PDK)
} else {
  set PDK sky130A
}

set XSCHEM_LIBRARY_PATH {}
append XSCHEM_LIBRARY_PATH :${PDK_ROOT}/${PDK}/libs.tech/xschem/sky130_fd_pr
append XSCHEM_LIBRARY_PATH :${XSCHEM_SHAREDIR}/xschem_library/devices
set here [file dirname [file normalize [info script]]]
foreach d {. ddr_mux predriver driver pad_cell} {
  append XSCHEM_LIBRARY_PATH :[file join $here $d]
}
